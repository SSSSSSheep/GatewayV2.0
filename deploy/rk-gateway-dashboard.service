[Unit]
Description=RK Gateway Dashboard
After=network.target

[Service]
Type=simple
User=admin123
WorkingDirectory=/home/admin123/embe/Project/RK_Gateway/rk-gateway-dashboard
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
